{
  "name": "nicolas-suarez-ops",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "type-check": "turbo run type-check",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "clean": "turbo run clean && rm -rf node_modules .turbo"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "cheerio": "^1.0.0",
    "chrome-launcher": "^1.1.2",
    "lighthouse": "^12.3.0",
    "prettier": "^3.7.4",
    "ts-node": "^10.9.2",
    "turbo": "^2.9.8",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@10.9.2"
}

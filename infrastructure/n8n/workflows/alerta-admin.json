{
  "name": "Alerta Admin — Nueva Reserva",
  "nodes": [
    {
      "parameters": {
        "event": "INSERT",
        "schema": "public",
        "table": "reservations",
        "channel": "reservations_realtime"
      },
      "id": "trigger-supabase",
      "name": "Supabase Trigger",
      "type": "n8n-nodes-base.supabaseTrigger",
      "typeVersion": 1,
      "position": [250, 300],
      "credentials": {
        "supabaseApi": {
          "id": "SUPABASE_CREDENTIAL_ID",
          "name": "Supabase Production"
        }
      },
      "notes": "Listens for new INSERTs on the reservations table via Supabase Realtime.\nTriggers immediately when a client submits a reservation."
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.record.client_name }}",
              "operation": "isNotEmpty"
            },
            {
              "value1": "={{ $json.record.whatsapp }}",
              "operation": "isNotEmpty"
            }
          ]
        }
      },
      "id": "validate-record",
      "name": "Validate Record",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [470, 300],
      "notes": "Validates that the new reservation has required fields before sending WhatsApp."
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "resolve-restaurant",
              "name": "restaurantName",
              "value": "={{ {'11111111-1111-1111-1111-111111111111': 'La Carreta', '22222222-2222-2222-2222-222222222222': 'Mar y Tierra Zipa', '33333333-3333-3333-3333-333333333333': 'Delica'}[$json.record.restaurant_id] || 'Restaurante' }}",
              "type": "string"
            },
            {
              "id": "format-date",
              "name": "formattedDate",
              "value": "={{ $json.record.date }}",
              "type": "string"
            },
            {
              "id": "format-time",
              "name": "formattedTime",
              "value": "={{ $json.record.time }}",
              "type": "string"
            }
          ]
        }
      },
      "id": "set-variables",
      "name": "Set Variables",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3,
      "position": [690, 200],
      "notes": "Maps restaurant_id to human-readable name and formats date/time for the message."
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "send",
        "phoneNumberId": "={{ $env.WHATSAPP_PHONE_NUMBER_ID }}",
        "recipientPhoneNumber": "={{ $env.ADMIN_WHATSAPP }}",
        "messageType": "text",
        "textBody": "={{ '🔔 *Nueva Reserva — ' + $json.restaurantName + '*\\n\\n👤 ' + $('Supabase Trigger').item.json.record.client_name + '\\n📅 ' + $json.formattedDate + ' a las ' + $json.formattedTime + '\\n👥 ' + $('Supabase Trigger').item.json.record.guests + ' personas\\n📱 ' + $('Supabase Trigger').item.json.record.whatsapp + ($('Supabase Trigger').item.json.record.notes ? '\\n📝 ' + $('Supabase Trigger').item.json.record.notes : '') + '\\n\\nEstado: ⏳ Pendiente' }}"
      },
      "id": "whatsapp-admin",
      "name": "WhatsApp a Nicolás",
      "type": "n8n-nodes-base.whatsApp",
      "typeVersion": 1,
      "position": [920, 200],
      "credentials": {
        "whatsAppApi": {
          "id": "WHATSAPP_CREDENTIAL_ID",
          "name": "WhatsApp Business API"
        }
      },
      "notes": "Sends an immediate WhatsApp alert to Nicolás with all reservation details.\nIncludes customer phone number for quick callback."
    },
    {
      "parameters": {},
      "id": "invalid-record",
      "name": "Invalid Record",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [690, 420],
      "notes": "Catch path for invalid/incomplete reservation records. No action taken."
    }
  ],
  "connections": {
    "Supabase Trigger": {
      "main": [
        [
          {
            "node": "Validate Record",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate Record": {
      "main": [
        [
          {
            "node": "Set Variables",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Invalid Record",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Set Variables": {
      "main": [
        [
          {
            "node": "WhatsApp a Nicolás",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "callerPolicy": "workflowsFromSameOwner"
  },
  "staticData": null,
  "tags": [
    {
      "name": "reservations",
      "id": "tag-reservations"
    },
    {
      "name": "alerts",
      "id": "tag-alerts"
    },
    {
      "name": "production",
      "id": "tag-production"
    }
  ],
  "meta": {
    "instanceId": "nicolas-suarez-ops",
    "templateCredsSetupCompleted": false
  },
  "pinData": {},
  "_README": {
    "description": "Alerta instantánea a Nicolás cuando llega una nueva reserva en cualquier restaurante",
    "version": "1.0",
    "author": "nicolas-suarez-ops",
    "envVars": [
      "WHATSAPP_PHONE_NUMBER_ID — Meta WhatsApp Business phone number ID",
      "ADMIN_WHATSAPP — Nicolás's phone number (+57XXXXXXXXXX)"
    ],
    "flow": [
      "1. Supabase Realtime detecta INSERT en tabla reservations",
      "2. n8n valida que el registro tenga campos obligatorios",
      "3. Resuelve nombre del restaurante desde restaurant_id",
      "4. Envía WhatsApp inmediato a Nicolás con todos los datos"
    ],
    "notes": "Este workflow es independiente del de confirmación. Solo notifica al admin. No envía nada al cliente."
  }
}
